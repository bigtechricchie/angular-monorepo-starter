#!/usr/bin/env bash
set -euo pipefail

COMMIT_MESSAGE_FILE="$1"
COMMIT_MESSAGE="$(head -n 1 "$COMMIT_MESSAGE_FILE")"

PATTERN='^(feat|fix|chore|docs|refactor|test|style|ci|build|security)(\([a-z0-9-]+\))?: .{1,100}$'

if ! printf '%s\n' "$COMMIT_MESSAGE" | grep -qE "$PATTERN"; then
  echo "Invalid commit message:"
  echo "  $COMMIT_MESSAGE"
  echo ""
  echo "Expected:"
  echo "  type(scope): description"
  echo "  type: description"
  echo ""
  exit 1
fi
