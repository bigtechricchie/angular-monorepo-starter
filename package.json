{
  "name": "angular-monorepo-starter",
  "version": "0.0.0",
  "description": "A security-conscious Angular and Go monorepo starter designed for fast prototyping and clear application boundaries.",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev:reference-app": "ng serve reference-app",
    "dev:portal-app": "ng serve portal-app",
    "test:reference-app": "ng test reference-app",
    "test:portal-app": "ng test portal-app",
    "test:ui-lib": "ng test ui-lib",
    "test:libs": "vitest run --config libs/vitest.config.ts",
    "typecheck:libs": "tsc --project libs/api/tsconfig.json && tsc --project libs/ui/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "jsdom": "28.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
