{
  "name": "angular-monorepo-starter",
  "version": "0.0.0",
  "description": "A security-conscious Angular and Go monorepo starter designed for fast prototyping and clear application boundaries.",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "build:reference-app": "ng build reference-app",
    "build:portal-app": "ng build portal-app",
    "dev:reference-app": "ng serve reference-app",
    "dev:portal-app": "ng serve portal-app",
    "test:reference-app": "ng test reference-app",
    "test:portal-app": "ng test portal-app",
    "test:api-lib": "vitest run --config libs/vitest.config.ts",
    "test:ui-lib": "ng test ui-lib",
    "test:libs": "pnpm run test:api-lib && pnpm run test:ui-lib --watch=false",
    "typecheck:libs": "tsc --project libs/api/tsconfig.json && tsc --project libs/i18n/tsconfig.json && tsc --project libs/ui/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.2",
    "vitest": "5.0.4"
  }
}
